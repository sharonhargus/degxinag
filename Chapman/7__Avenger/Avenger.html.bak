<li><p class='igt' id='i176'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/177.mp3" class='audio'>hidden</a><span class='words' id='i176w'><span class="word" id="i176w0">Q'ode</span><span class="word" id="i176w1">ɬo</span><span class="word" id="i176w2">viyiɬ gidiyghedhit,</span><span class="word" id="i176w3">tr'inedhinh</span><span class="word" id="i176w4">ts'in'.</span></span><br /><span class='glosses' id='i176g'><span class="gloss" id="i176g0">now</span><span class="gloss" id="i176g1">truly</span><span class="gloss" id="i176g2">it missed</span><span class="gloss" id="i176g3">someone was thinking</span></span><br /><span class='trans' id='i176ft'>'That was one time that it missed, someone was thinking.'<a href="#n35" class="notelink">35</a></span></p></li>
<li><p class='igt' id='i177'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/178.mp3" class='audio'>hidden</a><span class='words' id='i177w'><span class="word" id="i177w0">Nginigg</span><span class="word" id="i177w1">tr'edha</span><span class="word" id="i177w2">yix</span><span class="word" id="i177w3">xidhu'onh.</span></span><br /><span class='glosses' id='i177g'><span class="gloss" id="i177g0">back</span><span class="gloss" id="i177g1">behold</span><span class="gloss" id="i177g2">house</span><span class="gloss" id="i177g3">there is</span></span><br /><span class='trans' id='i177ft'>'There was a house back there.'</span></p></li>
<li><p class='igt' id='i178'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/179.mp3" class='audio'>hidden</a><span class='words' id='i178w'><span class="word" id="i178w0">Axaxiɬdik</span><span class="word" id="i178w1">doyixi</span><span class="word" id="i178w2">xiɬdi</span><span class="word" id="i178w3">xidontithiyo.</span></span><br /><span class='glosses' id='i178g'><span class="gloss" id="i178g0">then</span><span class="gloss" id="i178g1">down</span><span class="gloss" id="i178g2">then</span><span class="gloss" id="i178g3">she went inside</span></span><br /><span class='trans' id='i178ft'>'Then she went down into her house.'</span></p></li>
<li><p class='igt' id='i179'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/180.mp3" class='audio'>hidden</a><span class='words' id='i179w'><span class="word" id="i179w0">Yuxudz</span><span class="word" id="i179w1">yixi</span><span class="word" id="i179w2">xiyno'isr.</span></span><br /><span class='glosses' id='i179g'><span class="gloss" id="i179g0">just</span><span class="gloss" id="i179g1">there</span><span class="gloss" id="i179g2">they're following her</span></span><br /><span class='trans' id='i179ft'>'They followed close after her.'<a href="#n36" class="notelink">36</a></span></p></li>

<div id="main-container">
<h1>THE AVENGER</h1>
<h2>Charlie Longman <br /> recorded with Edna Deacon, 3-25-2004</h2>
<div id="controls-holder">
<div id="audio-holder"></div>
</div>
<div id="window"></div>
<div id="text">
<ol><li><p class='igt' id='i0'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/1.mp3" class='audio'>hidden</a><span class='words' id='i0w'><span class="word" id="i0w0">Agide</span><span class="word" id="i0w1">an</span><span class="word" id="i0w2">niɬ'oqay</span><span class="word" id="i0w3">tthuxdi</span><span class="word" id="i0w4">xididlitth'e.</span></span><br /><span class='glosses' id='i0g'><span class="gloss" id="i0g0">now then</span><span class="gloss" id="i0g1">those people</span><span class="gloss" id="i0g2">married couple</span><span class="gloss" id="i0g3">alone</span><span class="gloss" id="i0g4">they resided</span></span><br /><span class='trans' id='i0ft'>'A certain couple were living alone.'</span></p></li>
<li><p class='igt' id='i1'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/2.mp3" class='audio'>hidden</a><span class='words' id='i1w'><span class="word" id="i1w0">Uxudeyan'</span><span class="word" id="i1w1">yit</span><span class="word" id="i1w2">nixidinedaq.</span></span><br /><span class='glosses' id='i1g'><span class="gloss" id="i1g0">they only</span><span class="gloss" id="i1g1">there</span><span class="gloss" id="i1g2">they settled</span></span><br /><span class='trans' id='i1ft'>'They were living there all by themselves.'</span></p></li>
<li><p class='igt' id='i2'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/3.mp3" class='audio'>hidden</a><span class='words' id='i2w'><span class="word" id="i2w0">Yitots'in'</span><span class="word" id="i2w1">yit</span><span class="word" id="i2w2">idixanh</span><span class="word" id="i2w3">xivigege'</span><span class="word" id="i2w4">che</span><span class="word" id="i2w5">vixedhinix.</span></span><br /><span class='glosses' id='i2g'><span class="gloss" id="i2g0">now</span><span class="gloss" id="i2g1">there</span><span class="gloss" id="i2g2">last one</span><span class="gloss" id="i2g3">their children</span><span class="gloss" id="i2g4">also</span><span class="gloss" id="i2g5">he/she was lost</span></span><br /><span class='trans' id='i2ft'>'They had lost all of their children.'</span></p></li>
<li><p class='igt' id='i3'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/4.mp3" class='audio'>hidden</a><span class='words' id='i3w'><span class="word" id="i3w0">Yitots'in'</span><span class="word" id="i3w1">yixintl'u'ot.</span></span><br /><span class='glosses' id='i3g'><span class="gloss" id="i3g0">then</span><span class="gloss" id="i3g1">they looked forward to nothing</span></span><br /><span class='trans' id='i3ft'>'They looked forward to nothing from then on.'</span></p></li>
<li><p class='igt' id='i4'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/5.mp3" class='audio'>hidden</a><span class='words' id='i4w'><span class="word" id="i4w0">Axaxiɬdik</span><span class="word" id="i4w1">aygginh</span><span class="word" id="i4w2">viqing'</span><span class="word" id="i4w3">soghluq</span><span class="word" id="i4w4">dranh tux</span><span class="word" id="i4w5">yik'odz</span><span class="word" id="i4w6">tl'ino</span><span class="word" id="i4w7">ts'ixiyan'.</span></span><br /><span class='glosses' id='i4g'><span class="gloss" id="i4g0">then</span><span class="gloss" id="i4g1">that person</span><span class="gloss" id="i4g2">her husband</span><span class="gloss" id="i4g3">dear</span><span class="gloss" id="i4g4">daily</span><span class="gloss" id="i4g5">from her</span><span class="gloss" id="i4g6">he turned away</span><span class="gloss" id="i4g7">entirely</span></span><br /><span class='trans' id='i4ft'>'The husband turned entirely away from his wife.'</span></p></li>
<li><p class='igt' id='i5'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/6.mp3" class='audio'>hidden</a><span class='words' id='i5w'><span class="word" id="i5w0">Aɬonache</span><span class="word" id="i5w1">tth'inh</span><span class="word" id="i5w2">dina'</span><span class="word" id="i5w3">iɬtse.</span></span><br /><span class='glosses' id='i5g'><span class="gloss" id="i5g0">behold</span><span class="gloss" id="i5g1">bone</span><span class="gloss" id="i5g2">doll</span><span class="gloss" id="i5g3">he made</span></span><br /><span class='trans' id='i5ft'>'And then he made a doll of bone.'</span></p></li>
<li><p class='igt' id='i6'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/7.mp3" class='audio'>hidden</a><span class='words' id='i6w'><span class="word" id="i6w0">Dixinaɬt'ad</span><span class="word" id="i6w1">sre'</span><span class="word" id="i6w2">xinadhoɬ</span><span class="word" id="i6w3">ts'in'</span><span class="word" id="i6w4">xiyiɬdi</span><span class="word" id="i6w5">yiq'iniɬnek</span><span class="word" id="i6w6">ts'in',</span><span class="word" id="i6w7">yitots'in'</span><span class="word" id="i6w8">yinoghɬ</span><span class="word" id="i6w9">didithne' ts'in'.</span></span><br /><span class='glosses' id='i6g'><span class="gloss" id="i6g0">how many</span><span class="gloss" id="i6g1">not known</span><span class="gloss" id="i6g2">nights</span><span class="gloss" id="i6g3">as</span><span class="gloss" id="i6g4">then</span><span class="gloss" id="i6g5">he finished</span><span class="gloss" id="i6g6">as</span><span class="gloss" id="i6g7">moreover</span><span class="gloss" id="i6g8">to her</span><span class="gloss" id="i6g9">he did not tell</span></span><br /><span class='trans' id='i6ft'>'For many days after he had finished it he did not tell his wife about it.'</span></p></li>
<li><p class='igt' id='i7'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/8.mp3" class='audio'>hidden</a><span class='words' id='i7w'><span class="word" id="i7w0">Yitots'in'</span><span class="word" id="i7w1">yixi venhdida'</span><span class="word" id="i7w2">vinixiɬyiq</span><span class="word" id="i7w3">xiɬdik</span><span class="word" id="i7w4">vinixiɬts'eg dong</span><span class="word" id="i7w5">xiɬdik</span><span class="word" id="i7w6">tr'inedhit</span><span class="word" id="i7w7">eygginh</span><span class="word" id="i7w8">vu'ot</span><span class="word" id="i7w9">soghluq</span><span class="word" id="i7w10">viɬaɬtingh</span><span class="word" id="i7w11">hingo.</span></span><br /><span class='glosses' id='i7g'><span class="gloss" id="i7g0">then</span><span class="gloss" id="i7g1">next morning</span><span class="gloss" id="i7g2">morning</span><span class="gloss" id="i7g3">even</span><span class="gloss" id="i7g4">yesterday morning</span><span class="gloss" id="i7g5">then</span><span class="gloss" id="i7g6">he awoke</span><span class="gloss" id="i7g7">that person</span><span class="gloss" id="i7g8">his wife</span><span class="gloss" id="i7g9">dear</span><span class="gloss" id="i7g10">she's sleeping</span><span class="gloss" id="i7g11">while</span></span><br /><span class='trans' id='i7ft'>'Then one morning just after dawn the husband awoke while his wife was still sleeping.'</span></p></li>
<li><p class='igt' id='i8'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/9.mp3" class='audio'>hidden</a><span class='words' id='i8w'><span class="word" id="i8w0">Tr'edha</span><span class="word" id="i8w1">dhitanh.</span></span><br /><span class='glosses' id='i8g'><span class="gloss" id="i8g0">behold</span><span class="gloss" id="i8g1">she's lying</span></span><br /><span class='trans' id='i8ft'>'She was lying there.'</span></p></li>
<li><p class='igt' id='i9'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/10.mp3" class='audio'>hidden</a><span class='words' id='i9w'><span class="word" id="i9w0">Axaxiɬdik</span><span class="word" id="i9w1">yivit</span><span class="word" id="i9w2">q'idz</span><span class="word" id="i9w3">diyitltanh</span><span class="word" id="i9w4">ts'in',</span><span class="word" id="i9w5">yitots'in'</span><span class="word" id="i9w6">yiq'i</span><span class="word" id="i9w7">dilo'</span><span class="word" id="i9w8">di'itl-'onh.</span></span><br /><span class='glosses' id='i9g'><span class="gloss" id="i9g0">then</span><span class="gloss" id="i9g1">her belly</span><span class="gloss" id="i9g2">upon</span><span class="gloss" id="i9g3">he put it</span><span class="gloss" id="i9g4">and</span><span class="gloss" id="i9g5">then</span><span class="gloss" id="i9g6">on it</span><span class="gloss" id="i9g7">his hand</span><span class="gloss" id="i9g8">he lay</span></span><br /><span class='trans' id='i9ft'>'Then he put the doll upon her belly and laid his hand on it.'</span></p></li>
<li><p class='igt' id='i10'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/11.mp3" class='audio'>hidden</a><span class='words' id='i10w'><span class="word" id="i10w0">Xidigaɬ</span><span class="word" id="i10w1">xizroloche</span><span class="word" id="i10w2">vixedhinix</span><span class="word" id="i10w3">yit.</span></span><br /><span class='glosses' id='i10g'><span class="gloss" id="i10g0">finally</span><span class="gloss" id="i10g1">surely</span><span class="gloss" id="i10g2">it disappeared</span><span class="gloss" id="i10g3">there</span></span><br /><span class='trans' id='i10ft'>'Finally it disappeared.'</span></p></li>
<li><p class='igt' id='i11'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/12.mp3" class='audio'>hidden</a><span class='words' id='i11w'><span class="word" id="i11w0">Yitots'in'</span><span class="word" id="i11w1">che</span><span class="word" id="i11w2">nixinithidrit</span><span class="word" id="i11w3">luq.</span></span><br /><span class='glosses' id='i11g'><span class="gloss" id="i11g0">then</span><span class="gloss" id="i11g1">again</span><span class="gloss" id="i11g2">they lay abed</span><span class="gloss" id="i11g3">dear</span></span><br /><span class='trans' id='i11ft'>'Then they both slept.'</span></p></li>
<li><p class='igt' id='i12'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/13.mp3" class='audio'>hidden</a><span class='words' id='i12w'><span class="word" id="i12w0">E,</span><span class="word" id="i12w1">ayggi</span><span class="word" id="i12w2">yuxudz xiyan'</span><span class="word" id="i12w3">dalyoq</span><span class="word" id="i12w4">ts'in'</span><span class="word" id="i12w5">ghiluq.</span></span><br /><span class='glosses' id='i12g'><span class="gloss" id="i12g0">yes</span><span class="gloss" id="i12g1">that</span><span class="gloss" id="i12g2">always like that</span><span class="gloss" id="i12g3">he did</span><span class="gloss" id="i12g4"></span><span class="gloss" id="i12g5">dear</span></span><br /><span class='trans' id='i12ft'>'Yes, that is what he did'.</span></p></li>
<li><p class='igt' id='i13'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/14.mp3" class='audio'>hidden</a><span class='words' id='i13w'><span class="word" id="i13w0">Xiɬdi</span><span class="word" id="i13w1">tr'itadhit,</span><span class="word" id="i13w2">aygginh</span><span class="word" id="i13w3">vu'ot</span><span class="word" id="i13w4">soghluq.</span></span><br /><span class='glosses' id='i13g'><span class="gloss" id="i13g0">then</span><span class="gloss" id="i13g1">she started to wake up</span><span class="gloss" id="i13g2">that person</span><span class="gloss" id="i13g3">his wife</span><span class="gloss" id="i13g4">dear</span></span><br /><span class='trans' id='i13ft'>'Then his wife awoke.'</span></p></li>
<li><p class='igt' id='i14'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/15.mp3" class='audio'>hidden</a><span class='words' id='i14w'><span class="word" id="i14w0">Tth'e</span><span class="word" id="i14w1">xitl'i'ey ts'in'</span><span class="word" id="i14w2">xiɬdik</span><span class="word" id="i14w3">xoghli'eɬ</span><span class="word" id="i14w4">hingo</span><span class="word" id="i14w5">go</span><span class="word" id="i14w6">diyeloq.</span></span><br /><span class='glosses' id='i14g'><span class="gloss" id="i14g0">still</span><span class="gloss" id="i14g1">it's not light</span><span class="gloss" id="i14g2">when</span><span class="gloss" id="i14g3">it grew light</span><span class="gloss" id="i14g4">while</span><span class="gloss" id="i14g5">this</span><span class="gloss" id="i14g6">he did it</span></span><br /><span class='trans' id='i14ft'>'It had not yet been light when he had done that thing.'</span></p></li>
<li><p class='igt' id='i15'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/16.mp3" class='audio'>hidden</a><span class='words' id='i15w'><span class="word" id="i15w0">Ts'an</span><span class="word" id="i15w1">ts'in'</span><span class="word" id="i15w2">diggan'ithdongh</span><span class="word" id="i15w3">luq.</span></span><br /><span class='glosses' id='i15g'><span class="gloss" id="i15g0">so</span><span class="gloss" id="i15g1">then</span><span class="gloss" id="i15g2">she arose</span><span class="gloss" id="i15g3">poor thing</span></span><br /><span class='trans' id='i15ft'>'So the poor woman arose.'</span></p></li>
<li><p class='igt' id='i16'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/17.mp3" class='audio'>hidden</a><span class='words' id='i16w'><span class="word" id="i16w0">Yit</span><span class="word" id="i16w1">dit'anh ts'in'</span><span class="word" id="i16w2">ghiluq</span><span class="word" id="i16w3">tr'i'ne</span><span class="word" id="i16w4">digganxididltth'e</span><span class="word" id="i16w5">ts'in'</span><span class="word" id="i16w6">ghiluq</span><span class="word" id="i16w7">ts'in'</span><span class="word" id="i16w8">eyggi</span><span class="word" id="i16w9">gan sre'</span><span class="word" id="i16w10">axaxiɬdik</span><span class="word" id="i16w11">idughun xitl'inek</span><span class="word" id="i16w12">gixighehon'</span><span class="word" id="i16w13">ghiluq</span><span class="word" id="i16w14">n'iy.</span></span><br /><span class='glosses' id='i16g'><span class="gloss" id="i16g0">there</span><span class="gloss" id="i16g1">as usual</span><span class="gloss" id="i16g2">dear</span><span class="gloss" id="i16g3">they say</span><span class="gloss" id="i16g4">they're sitting up</span><span class="gloss" id="i16g5">while</span><span class="gloss" id="i16g6">dear</span><span class="gloss" id="i16g7"></span><span class="gloss" id="i16g8">that</span><span class="gloss" id="i16g9">whatever</span><span class="gloss" id="i16g10">then</span><span class="gloss" id="i16g11">they take care of themselves</span><span class="gloss" id="i16g12">they ate something</span><span class="gloss" id="i16g13">dear</span><span class="gloss" id="i16g14">that's all</span></span><br /><span class='trans' id='i16ft'>'They got up as they usually did and ate whatever food they had around.'</span></p></li>
<li><p class='igt' id='i17'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/18.mp3" class='audio'>hidden</a><span class='words' id='i17w'><span class="word" id="i17w0">E,</span><span class="word" id="i17w1">che</span><span class="word" id="i17w2">yuxudz</span><span class="word" id="i17w3">dighet'a'</span><span class="word" id="i17w4">ghiluq</span><span class="word" id="i17w5">ts'in'.</span></span><br /><span class='glosses' id='i17g'><span class="gloss" id="i17g0">yes</span><span class="gloss" id="i17g1">again</span><span class="gloss" id="i17g2">that</span><span class="gloss" id="i17g3">they did</span><span class="gloss" id="i17g4">dear</span></span><br /><span class='trans' id='i17ft'>'So they did.'</span></p></li>
<li><p class='igt' id='i18'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/19.mp3" class='audio'>hidden</a><span class='words' id='i18w'><span class="word" id="i18w0">Yitots'in'</span><span class="word" id="i18w1">nod</span><span class="word" id="i18w2">xinadhoɬ</span><span class="word" id="i18w3">xiyiɬ</span><span class="word" id="i18w4">vinixuɬyiq</span><span class="word" id="i18w5">ghiluq</span><span class="word" id="i18w6">tr'ixinedhit,</span><span class="word" id="i18w7">tr'i'ne.</span></span><br /><span class='glosses' id='i18g'><span class="gloss" id="i18g0">then</span><span class="gloss" id="i18g1">two</span><span class="gloss" id="i18g2">night</span><span class="gloss" id="i18g3">then</span><span class="gloss" id="i18g4">in the morning</span><span class="gloss" id="i18g5">dear</span><span class="gloss" id="i18g6">they awoke</span><span class="gloss" id="i18g7">they say</span></span><br /><span class='trans' id='i18ft'>'And after two nights had passed they awoke in the morning.'</span></p></li>
<li><p class='igt' id='i19'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/20.mp3" class='audio'>hidden</a><span class='words' id='i19w'><span class="word" id="i19w0">Uxuxiyiɬ</span><span class="word" id="i19w1">doniq</span><span class="word" id="i19w2">xits'in'</span><span class="word" id="i19w3">yits'andinitht'onh</span><span class="word" id="i19w4">eygginh</span><span class="word" id="i19w5">diqing'.</span></span><br /><span class='glosses' id='i19g'><span class="gloss" id="i19g0">then</span><span class="gloss" id="i19g1">back</span><span class="gloss" id="i19g2">towards</span><span class="gloss" id="i19g3">she turned towards him</span><span class="gloss" id="i19g4">that person</span><span class="gloss" id="i19g5">her husband</span></span><br /><span class='trans' id='i19ft'>'Then the woman turned to her husband.'</span></p></li>
<li><p class='igt' id='i20'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/21.mp3" class='audio'>hidden</a><span class='words' id='i20w'><span class="word" id="i20w0">&quot;Xidanh sre'</span><span class="word" id="i20w1">iy?&quot;</span><span class="word" id="i20w2">yiɬne,</span><span class="word" id="i20w3">tr'i'ne.</span></span><br /><span class='glosses' id='i20g'><span class="gloss" id="i20g0">where (hum.sg.)</span><span class="gloss" id="i20g1">it</span><span class="gloss" id="i20g2">she said</span><span class="gloss" id="i20g3">they say</span></span><br /><span class='trans' id='i20ft'>&quot;'Where are you?&quot; she said.'</span></p></li>

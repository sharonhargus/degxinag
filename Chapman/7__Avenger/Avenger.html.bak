<li><p class='igt' id='i181'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/182.mp3" class='audio'>hidden</a><span class='words' id='i181w'><span class="word" id="i181w0">Axaxiɬdik</span><span class="word" id="i181w1">vav</span><span class="word" id="i181w2">yiɬ</span><span class="word" id="i181w3">q'uxititl'inek.</span></span><br /><span class='glosses' id='i181g'><span class="gloss" id="i181g0">and then</span><span class="gloss" id="i181g1">food</span><span class="gloss" id="i181g2">with</span><span class="gloss" id="i181g3">she began to work</span></span><br /><span class='trans' id='i181ft'>'She began to prepare food.'</span></p></li>
<li><p class='igt' id='i182'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/183.mp3" class='audio'>hidden</a><span class='words' id='i182w'><span class="word" id="i182w0">Nigitr'inathtth'aq</span><span class="word" id="i182w1">engodz.</span></span><br /><span class='glosses' id='i182g'><span class="gloss" id="i182g0">she made ice cream</span><span class="gloss" id="i182g1">on the other side</span></span><br /><span class='trans' id='i182ft'>'She made Indian ice cream.'</span></p></li>

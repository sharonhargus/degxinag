<li><p class='igt' id='i53'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/54.mp3" class='audio'>hidden</a><span class='words' id='i53w'><span class="word" id="i53w0">Q'idoghtux</span><span class="word" id="i53w1">tr'i'ne</span><span class="word" id="i53w2">ngi'egh</span><span class="word" id="i53w3">tr'i'ne</span><span class="word" id="i53w4">eyggit</span><span class="word" id="i53w5">...</span></span><br /><span class='glosses' id='i53g'><span class="gloss" id="i53g0">once</span><span class="gloss" id="i53g1">they say</span><span class="gloss" id="i53g2">outside</span><span class="gloss" id="i53g3">they say</span><span class="gloss" id="i53g4">that</span></span><br /><span class='trans' id='i53ft'>'One time he was walking around outside...'</span></p></li>
<li><p class='igt' id='i54'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/55.mp3" class='audio'>hidden</a><span class='words' id='i54w'><span class="word" id="i54w0">&quot;Dina</span><span class="word" id="i54w1">xideyan'</span><span class="word" id="i54w2">godadz</span><span class="word" id="i54w3">ditr'et'a,&quot;</span><span class="word" id="i54w4">xaɬne</span><span class="word" id="i54w5">dan'at.</span></span><br /><span class='glosses' id='i54g'><span class="gloss" id="i54g0">people</span><span class="gloss" id="i54g1">we only</span><span class="gloss" id="i54g2">thus</span><span class="gloss" id="i54g3">we are</span><span class="gloss" id="i54g4">they say</span><span class="gloss" id="i54g5">that's so</span></span><br /><span class='trans' id='i54ft'>&quot;'We are the only ones around here,&quot; they said.'</span></p></li>
<li><p class='igt' id='i55'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/56.mp3" class='audio'>hidden</a><span class='words' id='i55w'><span class="word" id="i55w0">&quot;Xunh</span><span class="word" id="i55w1">deyan'</span><span class="word" id="i55w2">ghiluq</span><span class="word" id="i55w3">godadz</span><span class="word" id="i55w4">ditr'et'a</span><span class="word" id="i55w5">axaxiɬdik.&quot;</span></span><br /><span class='glosses' id='i55g'><span class="gloss" id="i55g0">we</span><span class="gloss" id="i55g1">only</span><span class="gloss" id="i55g2">dear</span><span class="gloss" id="i55g3">thus</span><span class="gloss" id="i55g4">we are</span><span class="gloss" id="i55g5">then</span></span><br /><span class='trans' id='i55ft'>&quot;'We are the only ones.&quot;'</span></p></li>
<li><p class='igt' id='i56'><a href="//depts.washington.edu/dxmedia/Chapman/7__Avenger/mp3/57.mp3" class='audio'>hidden</a><span class='words' id='i56w'><span class="word" id="i56w0">Aɬona</span><span class="word" id="i56w1">xiyk'o xitinadhen'</span><span class="word" id="i56w2">ts'in'</span><span class="word" id="i56w3">tr'i'ne.</span></span><br /><span class='glosses' id='i56g'><span class="gloss" id="i56g0">behold</span><span class="gloss" id="i56g1">they were bluffing him</span><span class="gloss" id="i56g2">as</span><span class="gloss" id="i56g3">they</span><span class="gloss" id="i56g4">say</span></span><br /><span class='trans' id='i56ft'>'But they were lying to him.'</span></p></li>

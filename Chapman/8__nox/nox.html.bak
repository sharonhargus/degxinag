<li><p class='igt' id='i310'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/311.mp3" class='audio'>hidden</a><span class='words' id='i310w'><span class="word" id="i310w0">Axaxiɬdik</span><span class="word" id="i310w1">yiggit</span><span class="word" id="i310w2">tth'eyiggi</span><span class="word" id="i310w3">dhidonh</span><span class="word" id="i310w4">ne</span><span class="word" id="i310w5">tr'i'ne,</span><span class="word" id="i310w6">&quot;ngi'in</span><span class="word" id="i310w7">gila</span><span class="word" id="i310w8">su'ot</span><span class="word" id="i310w9">ts'i</span><span class="word" id="i310w10">tthinehoyh,"</span><span class="word" id="i310w11">yiɬne</span><span class="word" id="i310w12">tr'i'ne.</span></span><br /><span class='glosses' id='i310g'><span class="gloss" id="i310g0">then</span><span class="gloss" id="i310g1">that</span><span class="gloss" id="i310g2">at home</span><span class="gloss" id="i310g3">the one who stayed</span><span class="gloss" id="i310g4">he says</span><span class="gloss" id="i310g5">it is said,</span><span class="gloss" id="i310g6">over</span><span class="gloss" id="i310g7">now</span><span class="gloss" id="i310g8">my wife</span><span class="gloss" id="i310g9">to</span><span class="gloss" id="i310g10">go out</span><span class="gloss" id="i310g11">he said</span><span class="gloss" id="i310g12">it is said</span></span><br /><span class='trans' id='i310ft'>'Then the one who hed remained at home said, &quot;Go over there to my wife.'</span></p></li>
<li><p class='igt' id='i311'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/312.mp3" class='audio'>hidden</a><span class='words' id='i311w'><span class="word" id="i311w0">&quot;Yitots'in'</span><span class="word" id="i311w1">sideche</span><span class="word" id="i311w2">ngu'ot</span><span class="word" id="i311w3">ts'in'</span><span class="word" id="i311w4">tasoɬ."</span></span><br /><span class='glosses' id='i311g'><span class="gloss" id="i311g0">then</span><span class="gloss" id="i311g1">I too</span><span class="gloss" id="i311g2">your wife</span><span class="gloss" id="i311g3">to</span><span class="gloss" id="i311g4">I will go</span></span><br /><span class='trans' id='i311ft'>&quot;'Then I too will go to your wife."'</span></p></li>
<li><p class='igt' id='i312'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/313.mp3" class='audio'>hidden</a><span class='words' id='i312w'><span class="word" id="i312w0">Daɬine'</span><span class="word" id="i312w1">yigginh</span><span class="word" id="i312w2">neg</span><span class="word" id="i312w3">yiɬne</span><span class="word" id="i312w4">tr'i'ne,</span><span class="word" id="i312w5">&quot;ngo</span><span class="word" id="i312w6">ngin' qogg</span><span class="word" id="i312w7">xidina'</span><span class="word" id="i312w8">ghela'</span><span class="word" id="i312w9">anh</span><span class="word" id="i312w10">vughun'</span><span class="word" id="i312w11">dhisdonh,"</span><span class="word" id="i312w12">yiɬne</span><span class="word" id="i312w13">tr'i'ne.</span></span><br /><span class='glosses' id='i312g'><span class="gloss" id="i312g0">but</span><span class="gloss" id="i312g1">that person</span><span class="gloss" id="i312g2">good</span><span class="gloss" id="i312g3">he said</span><span class="gloss" id="i312g4">it is said</span><span class="gloss" id="i312g5">well</span><span class="gloss" id="i312g6">earth</span><span class="gloss" id="i312g7">people</span><span class="gloss" id="i312g8">she is not</span><span class="gloss" id="i312g9">she</span><span class="gloss" id="i312g10">with her</span><span class="gloss" id="i312g11">the one I stay</span><span class="gloss" id="i312g12">he said</span><span class="gloss" id="i312g13">it is said</span></span><br /><span class='trans' id='i312ft'>'But the good man said, &quot;well, the one I stay with is not of earthly people."'</span></p></li>
<li><p class='igt' id='i313'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/314.mp3" class='audio'>hidden</a><span class='words' id='i313w'><span class="word" id="i313w0">Daɬine'</span><span class="word" id="i313w1">tr'i'ne</span><span class="word" id="i313w2">&quot;gila',"</span><span class="word" id="i313w3">yiɬne</span><span class="word" id="i313w4">tr'i'ne</span><span class="word" id="i313w5">yigginh</span><span class="word" id="i313w6">giɬigginh.</span></span><br /><span class='glosses' id='i313g'><span class="gloss" id="i313g0">but</span><span class="gloss" id="i313g1">it is said</span><span class="gloss" id="i313g2">Go on</span><span class="gloss" id="i313g3">he said</span><span class="gloss" id="i313g4">it is said</span><span class="gloss" id="i313g5">that person</span><span class="gloss" id="i313g6">other person</span></span><br /><span class='trans' id='i313ft'>'But the other said, &quot;go on."'</span></p></li>
<li><p class='igt' id='i314'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/315.mp3" class='audio'>hidden</a><span class='words' id='i314w'><span class="word" id="i314w0">&quot;Daɬine'</span><span class="word" id="i314w1">inagh,"</span><span class="word" id="i314w2">yiɬne</span><span class="word" id="i314w3">iɬt'et.</span></span><br /><span class='glosses' id='i314g'><span class="gloss" id="i314g0">but</span><span class="gloss" id="i314g1">no</span><span class="gloss" id="i314g2">he said</span><span class="gloss" id="i314g3">continuously</span></span><br /><span class='trans' id='i314ft'>&quot;'Oh no," said the first man.'</span></p></li>

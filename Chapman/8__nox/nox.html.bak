<li><p class='igt' id='i174'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/175.mp3" class='audio'>hidden</a><span class='words' id='i174w'><span class="word" id="i174w0">Axaxiɬdik</span><span class="word" id="i174w1">tr'i'ne</span><span class="word" id="i174w2">&quot;gila'</span><span class="word" id="i174w3">gon</span><span class="word" id="i174w4">ningiɬ'anh,&quot;</span><span class="word" id="i174w5">yiɬne</span><span class="word" id="i174w6">tr'i'ne.</span></span><br /><span class='glosses' id='i174g'><span class="gloss" id="i174g0">then</span><span class="gloss" id="i174g1">it is said</span><span class="gloss" id="i174g2">now</span><span class="gloss" id="i174g3">this</span><span class="gloss" id="i174g4">you look at</span><span class="gloss" id="i174g5">she told him</span><span class="gloss" id="i174g6">it is said</span></span><br /><span class='trans' id='i174ft'>'Then she said to him, &quot;look at this.&quot;'</span></p></li>
<li><p class='igt' id='i175'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/176.mp3" class='audio'>hidden</a><span class='words' id='i175w'><span class="word" id="i175w0">Axaxiɬdik</span><span class="word" id="i175w1">tr'i'ne</span><span class="word" id="i175w2">yenitl-'an'.</span></span><br /><span class='glosses' id='i175g'><span class="gloss" id="i175g0">then</span><span class="gloss" id="i175g1">it is said</span><span class="gloss" id="i175g2">he started to look at it</span></span><br /><span class='trans' id='i175ft'>'And he looked at it.'</span></p></li>
<li><p class='igt' id='i176'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/177.mp3" class='audio'>hidden</a><span class='words' id='i176w'><span class="word" id="i176w0">Yiniɬ'anh</span><span class="word" id="i176w1">ts'in'</span><span class="word" id="i176w2">yuxudz</span><span class="word" id="i176w3">t'asr</span><span class="word" id="i176w4">te'</span><span class="word" id="i176w5">xiq'iy</span><span class="word" id="i176w6">viye</span><span class="word" id="i176w7">dhuqonh.</span></span><br /><span class='glosses' id='i176g'><span class="gloss" id="i176g0">he looked</span><span class="gloss" id="i176g1">as</span><span class="gloss" id="i176g2">all</span><span class="gloss" id="i176g3">charcoal</span><span class="gloss" id="i176g4">water</span><span class="gloss" id="i176g5">as if it</span><span class="gloss" id="i176g6">in it</span><span class="gloss" id="i176g7">there is</span></span><br /><span class='trans' id='i176ft'>'The water looked just like charcoal in it.'</span></p></li>
<li><p class='igt' id='i177'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/178.mp3" class='audio'>hidden</a><span class='words' id='i177w'><span class="word" id="i177w0">Axaxiɬdik</span><span class="word" id="i177w1">deɬne</span><span class="word" id="i177w2">tr'i'ne</span><span class="word" id="i177w3">yigginh</span><span class="word" id="i177w4">niq'oɬonh,</span><span class="word" id="i177w5">&quot;gogide</span><span class="word" id="i177w6">iy</span><span class="word" id="i177w7">nongiyaɬ</span><span class="word" id="i177w8">dong</span><span class="word" id="i177w9">xuts'in'</span><span class="word" id="i177w10">vaxa</span><span class="word" id="i177w11">tr'a'ingit'ix</span><span class="word" id="i177w12">ts'in'</span><span class="word" id="i177w13">dangit'an',&quot;</span><span class="word" id="i177w14">yiɬne.</span></span><br /><span class='glosses' id='i177g'><span class="gloss" id="i177g0">then</span><span class="gloss" id="i177g1">she said</span><span class="gloss" id="i177g2">it is said</span><span class="gloss" id="i177g3">that person</span><span class="gloss" id="i177g4">woman</span><span class="gloss" id="i177g5">now</span><span class="gloss" id="i177g6">it</span><span class="gloss" id="i177g7">you're growing up</span><span class="gloss" id="i177g8">when</span><span class="gloss" id="i177g9">from</span><span class="gloss" id="i177g10">with it</span><span class="gloss" id="i177g11">you did evil</span><span class="gloss" id="i177g12"></span><span class="gloss" id="i177g13">you did</span><span class="gloss" id="i177g14">she said to him</span></span><br /><span class='trans' id='i177ft'>'And then the woman said, &quot;this is the evil that you have done since the time you grew up.&quot;'</span></p></li>
<li><p class='igt' id='i178'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/179.mp3" class='audio'>hidden</a><span class='words' id='i178w'><span class="word" id="i178w0">&quot;Gila</span><span class="word" id="i178w1">go</span><span class="word" id="i178w2">ningiɬ'anh</span><span class="word" id="i178w3">n-gitr'ixet'agh,&quot;</span><span class="word" id="i178w4">yiɬne.</span></span><br /><span class='glosses' id='i178g'><span class="gloss" id="i178g0">now</span><span class="gloss" id="i178g1">here</span><span class="gloss" id="i178g2">look at</span><span class="gloss" id="i178g3">your sin</span><span class="gloss" id="i178g4">she said</span></span><br /><span class='trans' id='i178ft'>&quot;'Look at your sins here,&quot; she said.'</span></p></li>

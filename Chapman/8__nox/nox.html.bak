<li><p class='igt' id='i87'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/88.mp3" class='audio'>hidden</a><span class='words' id='i87w'><span class="word" id="i87w0">Vadi xidhu'onh</span><span class="word" id="i87w1">hingo</span><span class="word" id="i87w2">xidonghidoɬ.</span></span><br /><span class='glosses' id='i87g'><span class="gloss" id="i87g0">she was gone</span><span class="gloss" id="i87g1">while</span><span class="gloss" id="i87g2">she's coming in again</span></span><br /><span class='trans' id='i87ft'>'She was gone for a moment then came back in.'</span></p></li>
<li><p class='igt' id='i88'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/89.mp3" class='audio'>hidden</a><span class='words' id='i88w'><span class="word" id="i88w0">Tr'edha</span><span class="word" id="i88w1">tr'i'ne</span><span class="word" id="i88w2">ggagg</span><span class="word" id="i88w3">dhith</span><span class="word" id="i88w4">gingin</span><span class="word" id="i88w5">q'ux</span><span class="word" id="i88w6">chux</span><span class="word" id="i88w7">xidon-ghoɬchith.</span></span><br /><span class='glosses' id='i88g'><span class="gloss" id="i88g0">behold</span><span class="gloss" id="i88g1">it is said</span><span class="gloss" id="i88g2">caribou</span><span class="gloss" id="i88g3">skin</span><span class="gloss" id="i88g4">its backbone</span><span class="gloss" id="i88g5">fat</span><span class="gloss" id="i88g6">big</span><span class="gloss" id="i88g7">she's bringing in</span></span><br /><span class='trans' id='i88ft'>'She brought in thick back sections of caribou skins.'<a href="#n14" class="notelink">14</a></span></p></li>

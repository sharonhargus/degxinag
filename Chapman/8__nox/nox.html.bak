<li><p class='igt' id='i343'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/344.mp3" class='audio'>hidden</a><span class='words' id='i343w'><span class="word" id="i343w0">Ndadz go xaxa</span><span class="word" id="i343w1">yadz niytolaɬ</span><span class="word" id="i343w2">tr'i'ne.</span></span><br /><span class='glosses' id='i343g'><span class="gloss" id="i343g0">how in the world</span><span class="gloss" id="i343g1">they will be separated</span><span class="gloss" id="i343g2">it is said</span></span><br /><span class='trans' id='i343ft'>'There was no way he could get free!'<a href="#n37" class="notelink">37</a></span></p></li>
<li><p class='igt' id='i344'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/345.mp3" class='audio'>hidden</a><span class='words' id='i344w'><span class="word" id="i344w0">Yit</span><span class="word" id="i344w1">diggandidhit</span><span class="word" id="i344w2">hingo</span><span class="word" id="i344w3">tathtrax</span><span class="word" id="i344w4">tr'i'ne.</span></span><br /><span class='glosses' id='i344g'><span class="gloss" id="i344g0">there</span><span class="gloss" id="i344g1">he stands</span><span class="gloss" id="i344g2">while</span><span class="gloss" id="i344g3">he started to cry</span><span class="gloss" id="i344g4">it is said</span></span><br /><span class='trans' id='i344ft'>'He stood there and started to cry.'</span></p></li>

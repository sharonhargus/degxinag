<li><p class='igt' id='i326'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/327.mp3" class='audio'>hidden</a><span class='words' id='i326w'><span class="word" id="i326w0">Yitots'in'</span><span class="word" id="i326w1">tr'i'ne</span><span class="word" id="i326w2">tthantithiyo</span><span class="word" id="i326w3">tr'i'ne.</span></span><br /><span class='glosses' id='i326g'><span class="gloss" id="i326g0">then</span><span class="gloss" id="i326g1">it is said</span><span class="gloss" id="i326g2">he went back outside</span><span class="gloss" id="i326g3">it is said</span></span><br /><span class='trans' id='i326ft'>'Then he went back outside.'</span></p></li>

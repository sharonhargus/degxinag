<li><p class='igt' id='i83'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/84.mp3" class='audio'>hidden</a><span class='words' id='i83w'><span class="word" id="i83w0">Axaxiɬdik</span><span class="word" id="i83w1">tr'edha</span><span class="word" id="i83w2">tr'i'ne</span><span class="word" id="i83w3">visriɬde'oy.</span></span><br /><span class='glosses' id='i83g'><span class="gloss" id="i83g0">and then</span><span class="gloss" id="i83g1">behold</span><span class="gloss" id="i83g2">it is said</span><span class="gloss" id="i83g3">it was steaming</span></span><br /><span class='trans' id='i83ft'>'And it was steaming.'</span></p></li>

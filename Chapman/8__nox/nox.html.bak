<li><p class='igt' id='i180'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/181.mp3" class='audio'>hidden</a><span class='words' id='i180w'><span class="word" id="i180w0">&quot;Agide&quot;</span><span class="word" id="i180w1">yiɬne</span><span class="word" id="i180w2">tr'i'ne.</span></span><br /><span class='glosses' id='i180g'><span class="gloss" id="i180g0">okay</span><span class="gloss" id="i180g1">he said</span><span class="gloss" id="i180g2">it is said</span></span><br /><span class='trans' id='i180ft'>&quot;'Okay,&quot; he said.'</span></p></li>
<li><p class='igt' id='i181'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/182.mp3" class='audio'>hidden</a><span class='words' id='i181w'><span class="word" id="i181w0">&quot;Agide</span><span class="word" id="i181w1">duxu</span><span class="word" id="i181w2">ts'in'</span><span class="word" id="i181w3">disengiloq,&quot;</span><span class="word" id="i181w4">yiɬne.</span></span><br /><span class='glosses' id='i181g'><span class="gloss" id="i181g0">now</span><span class="gloss" id="i181g1">all right</span><span class="gloss" id="i181g2"></span><span class="gloss" id="i181g3">you made me</span><span class="gloss" id="i181g4">he said.</span></span><br /><span class='trans' id='i181ft'>&quot;'Now you have made me all right.'</span></p></li>
<li><p class='igt' id='i182'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/183.mp3" class='audio'>hidden</a><span class='words' id='i182w'><span class="word" id="i182w0">&quot;Agide</span><span class="word" id="i182w1">getiy</span><span class="word" id="i182w2">ngughun'</span><span class="word" id="i182w3">xisrigasdhet,&quot;</span><span class="word" id="i182w4">yiɬne</span><span class="word" id="i182w5">tr'i'ne.</span></span><br /><span class='glosses' id='i182g'><span class="gloss" id="i182g0">now</span><span class="gloss" id="i182g1">really</span><span class="gloss" id="i182g2">to you</span><span class="gloss" id="i182g3">I am thankful</span><span class="gloss" id="i182g4">he said</span><span class="gloss" id="i182g5">it is said</span></span><br /><span class='trans' id='i182ft'>'Now I am very thankful to you.&quot;'<a href="#n25" class="notelink">25</a></span></p></li>

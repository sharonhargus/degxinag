<li><p class='igt' id='i144'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/145.mp3" class='audio'>hidden</a><span class='words' id='i144w'><span class="word" id="i144w0">Uxu(xi)yiɬ</span><span class="word" id="i144w1">tr'ixilimaq</span><span class="word" id="i144w2">ndagh</span><span class="word" id="i144w3">getiy</span><span class="word" id="i144w4">che</span><span class="word" id="i144w5">yixi</span><span class="word" id="i144w6">xili'in'</span><span class="word" id="i144w7">axa</span><span class="word" id="i144w8">tr'ixilimaq.</span></span><br /><span class='glosses' id='i144g'><span class="gloss" id="i144g0">then</span><span class="gloss" id="i144g1">it became light</span><span class="gloss" id="i144g2">where</span><span class="gloss" id="i144g3">really</span><span class="gloss" id="i144g4">also</span><span class="gloss" id="i144g5">there</span><span class="gloss" id="i144g6">it shone</span><span class="gloss" id="i144g7">with</span><span class="gloss" id="i144g8">it got bright</span></span><br /><span class='trans' id='i144ft'>'Suddenly it became very light, shining brightly.'</span></p></li>
<li><p class='igt' id='i145'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/146.mp3" class='audio'>hidden</a><span class='words' id='i145w'><span class="word" id="i145w0">Uxu(xi)yiɬ</span><span class="word" id="i145w1">tr'igitr'aghɬdluq</span><span class="word" id="i145w2">yixi</span><span class="word" id="i145w3">gidentlninghdi</span><span class="word" id="i145w4">ndagh</span><span class="word" id="i145w5">gidet</span><span class="word" id="i145w6">xogh ggusr quldi</span><span class="word" id="i145w7">ghedo'inh</span><span class="word" id="i145w8">nuq'oɬonh</span><span class="word" id="i145w9">ngixits'i</span><span class="word" id="i145w10">yughun'</span><span class="word" id="i145w11">nigidluq</span><span class="word" id="i145w12">tr'i'ne.</span></span><br /><span class='glosses' id='i145g'><span class="gloss" id="i145g0">then</span><span class="gloss" id="i145g1">someone laughed</span><span class="gloss" id="i145g2">there</span><span class="gloss" id="i145g3">where he turned around</span><span class="gloss" id="i145g4">where</span><span class="gloss" id="i145g5">very</span><span class="gloss" id="i145g6">clean place</span><span class="gloss" id="i145g7">one who stayed</span><span class="gloss" id="i145g8">woman</span><span class="gloss" id="i145g9">from inside</span><span class="gloss" id="i145g10">at him</span><span class="gloss" id="i145g11">she's laughing</span><span class="gloss" id="i145g12">it is said</span></span><br /><span class='trans' id='i145ft'>'Then someone laughed and when he turned around there was a woman back in a clean place.'<a href="#n21" class="notelink">21</a></span></p></li>
<li><p class='igt' id='i146'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/147.mp3" class='audio'>hidden</a><span class='words' id='i146w'><span class="word" id="i146w0">Yitongo</span><span class="word" id="i146w1">tr'i'ne,</span><span class="word" id="i146w2">di'ne</span><span class="word" id="i146w3">nuq'oɬonh,</span><span class="word" id="i146w4">&quot;ndadz</span><span class="word" id="i146w5">dingit'anh?&quot;</span><span class="word" id="i146w6">yiɬne.</span></span><br /><span class='glosses' id='i146g'><span class="gloss" id="i146g0">meanwhile</span><span class="gloss" id="i146g1">it is said</span><span class="gloss" id="i146g2">she said</span><span class="gloss" id="i146g3">woman</span><span class="gloss" id="i146g4">what</span><span class="gloss" id="i146g5">you're doing</span><span class="gloss" id="i146g6">she said</span></span><br /><span class='trans' id='i146ft'>'Then the woman said, &quot;what are you doing?&quot;'</span></p></li>
<li><p class='igt' id='i147'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/148.mp3" class='audio'>hidden</a><span class='words' id='i147w'><span class="word" id="i147w0">&quot;Ngo,</span><span class="word" id="i147w1">singonh</span><span class="word" id="i147w2">anh!&quot;</span><span class="word" id="i147w3">yiɬne</span><span class="word" id="i147w4">tr'i'ne.</span></span><br /><span class='glosses' id='i147g'><span class="gloss" id="i147g0">well</span><span class="gloss" id="i147g1">my mother</span><span class="gloss" id="i147g2">she</span><span class="gloss" id="i147g3">she said</span><span class="gloss" id="i147g4">it is said</span></span><br /><span class='trans' id='i147ft'>&quot;'Why that is my mother!&quot; she said.'</span></p></li>
<li><p class='igt' id='i148'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/149.mp3" class='audio'>hidden</a><span class='words' id='i148w'><span class="word" id="i148w0">Uxuxiyiɬ</span><span class="word" id="i148w1">tr'i'ne</span><span class="word" id="i148w2">yigginh</span><span class="word" id="i148w3">chel</span><span class="word" id="i148w4">anh</span><span class="word" id="i148w5">viq'ay xontl'u'onh</span><span class="word" id="i148w6">tr'i'ne.</span></span><br /><span class='glosses' id='i148g'><span class="gloss" id="i148g0">then</span><span class="gloss" id="i148g1">it is said</span><span class="gloss" id="i148g2">that person</span><span class="gloss" id="i148g3">young man</span><span class="gloss" id="i148g4">he</span><span class="gloss" id="i148g5">he became ashamed</span><span class="gloss" id="i148g6">it is said</span></span><br /><span class='trans' id='i148ft'>'Then the man became ashamed.'</span></p></li>
<li><p class='igt' id='i149'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/150.mp3" class='audio'>hidden</a><span class='words' id='i149w'><span class="word" id="i149w0">&quot;One,&quot;</span><span class="word" id="i149w1">yiɬne</span><span class="word" id="i149w2">ts'in'</span><span class="word" id="i149w3">yits'i</span><span class="word" id="i149w4">tadhiyo</span><span class="word" id="i149w5">tr'i'ne.</span></span><br /><span class='glosses' id='i149g'><span class="gloss" id="i149g0">come</span><span class="gloss" id="i149g1">she said</span><span class="gloss" id="i149g2">and</span><span class="gloss" id="i149g3">to her</span><span class="gloss" id="i149g4">he went</span><span class="gloss" id="i149g5">it is said</span></span><br /><span class='trans' id='i149ft'>&quot;'Come here,&quot; she said, and he went to her.'<a href="#n22" class="notelink">22</a></span></p></li>
<li><p class='igt' id='i150'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/151.mp3" class='audio'>hidden</a><span class='words' id='i150w'><span class="word" id="i150w0">Axaxiɬdik</span><span class="word" id="i150w1">tr'i'ne</span><span class="word" id="i150w2">di'ne</span><span class="word" id="i150w3">tr'i'ne</span><span class="word" id="i150w4">yigginh</span><span class="word" id="i150w5">nuq'oɬonh,</span><span class="word" id="i150w6">&quot;agide</span><span class="word" id="i150w7">singonh</span><span class="word" id="i150w8">oxo</span><span class="word" id="i150w9">ingizrenh</span><span class="word" id="i150w10">duxo'in,&quot;</span><span class="word" id="i150w11">yiɬne</span><span class="word" id="i150w12">tr'i'ne,</span><span class="word" id="i150w13">&quot;got</span><span class="word" id="i150w14">dinayix</span><span class="word" id="i150w15">ngits'in'</span><span class="word" id="i150w16">tr'axiyan nixine'onh,&quot;</span><span class="word" id="i150w17">yiɬne</span><span class="word" id="i150w18">tr'i'ne.</span></span><br /><span class='glosses' id='i150g'><span class="gloss" id="i150g0">and then</span><span class="gloss" id="i150g1">it is said</span><span class="gloss" id="i150g2">she spoke</span><span class="gloss" id="i150g3">it is said</span><span class="gloss" id="i150g4">that person</span><span class="gloss" id="i150g5">woman</span><span class="gloss" id="i150g6">now</span><span class="gloss" id="i150g7">my mother</span><span class="gloss" id="i150g8">for</span><span class="gloss" id="i150g9">you're good</span><span class="gloss" id="i150g10">because</span><span class="gloss" id="i150g11">she said</span><span class="gloss" id="i150g12">it is said</span><span class="gloss" id="i150g13">this</span><span class="gloss" id="i150g14">our house</span><span class="gloss" id="i150g15">to you</span><span class="gloss" id="i150g16">she revealed</span><span class="gloss" id="i150g17">she said</span><span class="gloss" id="i150g18">it is said</span></span><br /><span class='trans' id='i150ft'>'And then the woman spoke to him, &quot;now because you seemed good to my mother she revealed this house of ours to you.&quot;'</span></p></li>

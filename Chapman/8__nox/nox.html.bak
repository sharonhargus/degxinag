<li><p class='igt' id='i74'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/75.mp3" class='audio'>hidden</a><span class='words' id='i74w'><span class="word" id="i74w0">Axaxiɬdik</span><span class="word" id="i74w1">di'ne</span><span class="word" id="i74w2">ts'in'</span><span class="word" id="i74w3">yigginh</span><span class="word" id="i74w4">nuq'oɬonh,</span><span class="word" id="i74w5">tr'ixinengo,</span><span class="word" id="i74w6">&quot;n-gide</span><span class="word" id="i74w7">sixiyo'</span><span class="word" id="i74w8">q'i</span><span class="word" id="i74w9">daɬts'idz</span><span class="word" id="i74w10">tayo.</span></span><br /><span class='glosses' id='i74g'><span class="gloss" id="i74g0">then</span><span class="gloss" id="i74g1">she said</span><span class="gloss" id="i74g2"></span><span class="gloss" id="i74g3">that</span><span class="gloss" id="i74g4">woman</span><span class="gloss" id="i74g5">she spoke out</span><span class="gloss" id="i74g6">all right</span><span class="gloss" id="i74g7">my wisdom</span><span class="gloss" id="i74g8">due to</span><span class="gloss" id="i74g9">this way</span><span class="gloss" id="i74g10">you came</span></span><br /><span class='trans' id='i74ft'>'And she spoke out saying, &quot;look, you have come this way on account of my wisdom.'<a href="#n11" class="notelink">11</a><a href="#n12" class="notelink">12</a></span></p></li>
<li><p class='igt' id='i75'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/76.mp3" class='audio'>hidden</a><span class='words' id='i75w'><span class="word" id="i75w0">Gogide</span><span class="word" id="i75w1">edi</span><span class="word" id="i75w2">ngan'</span><span class="word" id="i75w3">q'idz</span><span class="word" id="i75w4">xintl-'anh</span><span class="word" id="i75w5">ine'</span><span class="word" id="i75w6">diva</span><span class="word" id="i75w7">ine'</span><span class="word" id="i75w8">anh</span><span class="word" id="i75w9">nedr</span><span class="word" id="i75w10">ginistolts'in'.</span></span><br /><span class='glosses' id='i75g'><span class="gloss" id="i75g0">well</span><span class="gloss" id="i75g1">all</span><span class="gloss" id="i75g2">world</span><span class="gloss" id="i75g3">upon</span><span class="gloss" id="i75g4">I'm looking around</span><span class="gloss" id="i75g5">but</span><span class="gloss" id="i75g6">someone</span><span class="gloss" id="i75g7">but</span><span class="gloss" id="i75g8">that person</span><span class="gloss" id="i75g9">meeting</span><span class="gloss" id="i75g10">I didn't see</span></span><br /><span class='trans' id='i75ft'>'I looked all over the world but I didn't see anyone.'<a href="#n13" class="notelink">13</a></span></p></li>
<li><p class='igt' id='i76'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/77.mp3" class='audio'>hidden</a><span class='words' id='i76w'><span class="word" id="i76w0">Ngideyan'</span><span class="word" id="i76w1">ngit'iginistoyh,</span><span class="word" id="i76w2">go</span><span class="word" id="i76w3">ngan'</span><span class="word" id="i76w4">q'idz,&quot;</span><span class="word" id="i76w5">yiɬne.</span></span><br /><span class='glosses' id='i76g'><span class="gloss" id="i76g0">only you</span><span class="gloss" id="i76g1">I caught sight of you</span><span class="gloss" id="i76g2">this</span><span class="gloss" id="i76g3">world</span><span class="gloss" id="i76g4">on</span><span class="gloss" id="i76g5">she said</span></span><br /><span class='trans' id='i76ft'>'On all the world I only caught sight of you.'</span></p></li>
<li><p class='igt' id='i77'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/78.mp3" class='audio'>hidden</a><span class='words' id='i77w'><span class="word" id="i77w0">&quot;Soxo</span><span class="word" id="i77w1">engizrenh</span><span class="word" id="i77w2">duxo'in,</span><span class="word" id="i77w3">siyix</span><span class="word" id="i77w4">ngits'i</span><span class="word" id="i77w5">tr'axiyan</span><span class="word" id="i77w6">nixinis'onh,&quot;</span><span class="word" id="i77w7">yiɬne.</span></span><br /><span class='glosses' id='i77g'><span class="gloss" id="i77g0">for me</span><span class="gloss" id="i77g1">you are good</span><span class="gloss" id="i77g2">because</span><span class="gloss" id="i77g3">my house</span><span class="gloss" id="i77g4">to you</span><span class="gloss" id="i77g5">in the open</span><span class="gloss" id="i77g6">I showed</span><span class="gloss" id="i77g7">she said</span></span><br /><span class='trans' id='i77ft'>&quot;'Since you seem good to me I have shown you my house,&quot; she said.'</span></p></li>

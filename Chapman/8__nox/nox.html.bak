<li><p class='igt' id='i276'><a href="//depts.washington.edu/dxmedia/Chapman/8__nox/mp3/277.mp3" class='audio'>hidden</a><span class='words' id='i276w'><span class="word" id="i276w0">&quot;Ngo</span><span class="word" id="i276w1">ngin' qogg</span><span class="word" id="i276w2">xidina'</span><span class="word" id="i276w3">ghela'</span><span class="word" id="i276w4">ts'ixiyan,"</span><span class="word" id="i276w5">yiɬne.</span></span><br /><span class='glosses' id='i276g'><span class="gloss" id="i276g0">well</span><span class="gloss" id="i276g1">earth</span><span class="gloss" id="i276g2">people</span><span class="gloss" id="i276g3">she was</span><span class="gloss" id="i276g4">at all</span><span class="gloss" id="i276g5">she said</span></span><br /><span class='trans' id='i276ft'>&quot;'She is not an earthly person at all."'<a href="#n32" class="notelink">32</a></span></p></li>

<li><p class='igt' id='i40'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/41.mp3" class='audio'>hidden</a><span class='words' id='i40w'><span class="word" id="i40w0">&quot;Ngo</span><span class="word" id="i40w1">sidedig</span><span class="word" id="i40w2">su'ot</span><span class="word" id="i40w3">xelanh,</span><span class="word" id="i40w4">sigege'qay</span><span class="word" id="i40w5">yiɬ</span><span class="word" id="i40w6">xelanh,&quot;</span><span class="word" id="i40w7">yiɬne.</span></span><br /><span class='glosses' id='i40g'><span class="gloss" id="i40g0">well</span><span class="gloss" id="i40g1">me too</span><span class="gloss" id="i40g2">my wife</span><span class="gloss" id="i40g3">there is</span><span class="gloss" id="i40g4">my children</span><span class="gloss" id="i40g5">too</span><span class="gloss" id="i40g6">there are</span><span class="gloss" id="i40g7">he said to him</span></span><br /><span class='trans' id='i40ft'>&quot;'I too have a wife and children too.&quot;'</span></p></li>
<li><p class='igt' id='i41'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/42.mp3" class='audio'>hidden</a><span class='words' id='i41w'><span class="word" id="i41w0">&quot;Venhda'</span><span class="word" id="i41w1">siyiɬ</span><span class="word" id="i41w2">ntedoɬ,&quot;</span><span class="word" id="i41w3">yiɬne,</span><span class="word" id="i41w4">&quot;siqay</span><span class="word" id="i41w5">xits'in'.</span></span><br /><span class='glosses' id='i41g'><span class="gloss" id="i41g0">tomorrow</span><span class="gloss" id="i41g1">with me</span><span class="gloss" id="i41g2">you'll return</span><span class="gloss" id="i41g3">he said to him</span><span class="gloss" id="i41g4">my village</span><span class="gloss" id="i41g5">to</span></span><br /><span class='trans' id='i41ft'>&quot;'Come back with me tomorrow to my village.'</span></p></li>
<li><p class='igt' id='i42'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/43.mp3" class='audio'>hidden</a><span class='words' id='i42w'><span class="word" id="i42w0">Siqay</span><span class="word" id="i42w1">ngiqay</span><span class="word" id="i42w2">ngidigg xezrenh.</span></span><br /><span class='glosses' id='i42g'><span class="gloss" id="i42g0">my village</span><span class="gloss" id="i42g1">your village</span><span class="gloss" id="i42g2">it's nicer</span></span><br /><span class='trans' id='i42ft'>'My village is better than your village.'<a href="#n4" class="notelink">4</a></span></p></li>
<li><p class='igt' id='i43'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/44.mp3" class='audio'>hidden</a><span class='words' id='i43w'><span class="word" id="i43w0">Gidhith</span><span class="word" id="i43w1">long</span><span class="word" id="i43w2">xelanh</span><span class="word" id="i43w3">inisdhinh,&quot;</span><span class="word" id="i43w4">yiɬne.</span></span><br /><span class='glosses' id='i43g'><span class="gloss" id="i43g0">skins</span><span class="gloss" id="i43g1">many</span><span class="gloss" id="i43g2">there are</span><span class="gloss" id="i43g3">I think</span><span class="gloss" id="i43g4">he said to him</span></span><br /><span class='trans' id='i43ft'>'There are a lot of skins there too&quot;, he said.'</span></p></li>
<li><p class='igt' id='i44'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/45.mp3" class='audio'>hidden</a><span class='words' id='i44w'><span class="word" id="i44w0">&quot;Iy</span><span class="word" id="i44w1">luxdong'</span><span class="word" id="i44w2">ngiye'</span><span class="word" id="i44w3">lay,&quot;</span><span class="word" id="i44w4">yiɬne.</span></span><br /><span class='glosses' id='i44g'><span class="gloss" id="i44g0">that</span><span class="gloss" id="i44g1">some of</span><span class="gloss" id="i44g2">your belongings</span><span class="gloss" id="i44g3">material</span><span class="gloss" id="i44g4">he said to him</span></span><br /><span class='trans' id='i44ft'>' &quot;Some will be yours,&quot; he told him.'</span></p></li>
<li><p class='igt' id='i45'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/46.mp3" class='audio'>hidden</a><span class='words' id='i45w'><span class="word" id="i45w0">Daɬine'</span><span class="word" id="i45w1">dina</span><span class="word" id="i45w2">inedhints'in'.</span></span><br /><span class='glosses' id='i45g'><span class="gloss" id="i45g0">but</span><span class="gloss" id="i45g1">man</span><span class="gloss" id="i45g2">he didn't intend to</span></span><br /><span class='trans' id='i45ft'>'But the man didn't want to.'</span></p></li>
<li><p class='igt' id='i46'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/47.mp3" class='audio'>hidden</a><span class='words' id='i46w'><span class="word" id="i46w0">Daɬine'</span><span class="word" id="i46w1">&quot;gil</span><span class="word" id="i46w2">iningito,&quot;</span><span class="word" id="i46w3">yiɬne.</span></span><br /><span class='glosses' id='i46g'><span class="gloss" id="i46g0">but</span><span class="gloss" id="i46g1">okay</span><span class="gloss" id="i46g2">hurry</span><span class="gloss" id="i46g3">he said</span></span><br /><span class='trans' id='i46ft'>'But &quot;okay, hurry,&quot; he said.'</span></p></li>
<li><p class='igt' id='i47'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/48.mp3" class='audio'>hidden</a><span class='words' id='i47w'><span class="word" id="i47w0">&quot;Iningito.</span><span class="word" id="i47w1">Siyiɬ</span><span class="word" id="i47w2">ntedoyh,&quot;</span><span class="word" id="i47w3">yiɬne.</span></span><br /><span class='glosses' id='i47g'><span class="gloss" id="i47g0">hurry</span><span class="gloss" id="i47g1">with me</span><span class="gloss" id="i47g2">you come back</span><span class="gloss" id="i47g3">he said</span></span><br /><span class='trans' id='i47ft'>&quot;'Come on, come back with me,&quot; he said.'</span></p></li>
<li><p class='igt' id='i48'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/49.mp3" class='audio'>hidden</a><span class='words' id='i48w'><span class="word" id="i48w0">Yitots'in'</span><span class="word" id="i48w1">tthan'ititht'ots.</span></span><br /><span class='glosses' id='i48g'><span class="gloss" id="i48g0">so then</span><span class="gloss" id="i48g1">they went outside</span></span><br /><span class='trans' id='i48ft'>'So they went out.'</span></p></li>
<li><p class='igt' id='i49'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/50.mp3" class='audio'>hidden</a><span class='words' id='i49w'><span class="word" id="i49w0">Eygginh</span><span class="word" id="i49w1">dina</span><span class="word" id="i49w2">yik'odz</span><span class="word" id="i49w3">ntithiyo.</span></span><br /><span class='glosses' id='i49g'><span class="gloss" id="i49g0">that</span><span class="gloss" id="i49g1">man</span><span class="gloss" id="i49g2">away from him</span><span class="gloss" id="i49g3">he started to walk</span></span><br /><span class='trans' id='i49ft'>'The man started to walk away from (ahead of) him.'</span></p></li>
<li><p class='igt' id='i50'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/51.mp3" class='audio'>hidden</a><span class='words' id='i50w'><span class="word" id="i50w0">Dit'anh</span><span class="word" id="i50w1">hingo</span><span class="word" id="i50w2">Yixgitsiy</span><span class="word" id="i50w3">diggadhu'oy</span><span class="word" id="i50w4">oqo</span><span class="word" id="i50w5">tathtrit.</span></span><br /><span class='glosses' id='i50g'><span class="gloss" id="i50g0">he's doing</span><span class="gloss" id="i50g1">while</span><span class="gloss" id="i50g2">Raven</span><span class="gloss" id="i50g3">knife</span><span class="gloss" id="i50g4">for</span><span class="gloss" id="i50g5">he reached</span></span><br /><span class='trans' id='i50ft'>'And while the man was doing that, Raven pulled out his knife.'</span></p></li>
<li><p class='igt' id='i51'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/52.mp3" class='audio'>hidden</a><span class='words' id='i51w'><span class="word" id="i51w0">Go</span><span class="word" id="i51w1">xiniygheyiɬ.</span></span><br /><span class='glosses' id='i51g'><span class="gloss" id="i51g0">here</span><span class="gloss" id="i51g1">he stuck it in the ground</span></span><br /><span class='trans' id='i51ft'>'He stuck it into the ground.'</span></p></li>
<li><p class='igt' id='i52'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/53.mp3" class='audio'>hidden</a><span class='words' id='i52w'><span class="word" id="i52w0">Uxuxiyiɬ</span><span class="word" id="i52w1">xonuq</span><span class="word" id="i52w2">nixititht'ots.</span></span><br /><span class='glosses' id='i52g'><span class="gloss" id="i52g0">and then</span><span class="gloss" id="i52g1">back from river</span><span class="gloss" id="i52g2">they went</span></span><br /><span class='trans' id='i52ft'>'And then they walked away from the river.'</span></p></li>
<li><p class='igt' id='i53'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/54.mp3" class='audio'>hidden</a><span class='words' id='i53w'><span class="word" id="i53w0">Deg</span><span class="word" id="i53w1">nginiggi</span><span class="word" id="i53w2">xo'isr,</span><span class="word" id="i53w3">xiyiɬ</span><span class="word" id="i53w4">Yixgitsiy</span><span class="word" id="i53w5">nonghidizreɬ.</span></span><br /><span class='glosses' id='i53g'><span class="gloss" id="i53g0">here</span><span class="gloss" id="i53g1">upland</span><span class="gloss" id="i53g2">they 2 are going</span><span class="gloss" id="i53g3">and</span><span class="gloss" id="i53g4">Raven</span><span class="gloss" id="i53g5">he cried out</span></span><br /><span class='trans' id='i53ft'>'As they were going along in the back country Raven cried out.'</span></p></li>
<li><p class='igt' id='i54'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/55.mp3" class='audio'>hidden</a><span class='words' id='i54w'><span class="word" id="i54w0">&quot;Sigidiggadhu'oy</span><span class="word" id="i54w1">andhiginix,&quot;</span><span class="word" id="i54w2">ne.</span></span><br /><span class='glosses' id='i54g'><span class="gloss" id="i54g0">my knife</span><span class="gloss" id="i54g1">I lost</span><span class="gloss" id="i54g2">he said</span></span><br /><span class='trans' id='i54ft'>&quot;'I lost my knife,&quot; he said.'</span></p></li>
<li><p class='igt' id='i55'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/56.mp3" class='audio'>hidden</a><span class='words' id='i55w'><span class="word" id="i55w0">Xiyiɬ</span><span class="word" id="i55w1">dina</span><span class="word" id="i55w2">&quot;isda,&quot;</span><span class="word" id="i55w3">yiɬne,</span><span class="word" id="i55w4">&quot;soxo</span><span class="word" id="i55w5">voqo</span><span class="word" id="i55w6">nitedoyh,&quot;</span><span class="word" id="i55w7">yiɬne.</span></span><br /><span class='glosses' id='i55g'><span class="gloss" id="i55g0">then</span><span class="gloss" id="i55g1">man</span><span class="gloss" id="i55g2">friend</span><span class="gloss" id="i55g3">he said to him</span><span class="gloss" id="i55g4">for me</span><span class="gloss" id="i55g5">for it</span><span class="gloss" id="i55g6">go back</span><span class="gloss" id="i55g7">he said</span></span><br /><span class='trans' id='i55ft'>&quot;'Friend, go back and get it for me.'</span></p></li>
<li><p class='igt' id='i56'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/57.mp3" class='audio'>hidden</a><span class='words' id='i56w'><span class="word" id="i56w0">&quot;Gitsighiy</span><span class="word" id="i56w1">giɬigg</span><span class="word" id="i56w2">tixet'an</span><span class="word" id="i56w3">chenh,</span><span class="word" id="i56w4">giɬigg</span><span class="word" id="i56w5">noya'</span><span class="word" id="i56w6">dhith</span><span class="word" id="i56w7">che,</span><span class="word" id="i56w8">giɬigg</span><span class="word" id="i56w9">ngitl'otatlaɬ</span><span class="word" id="i56w10">vidiɬghot.</span></span><br /><span class='glosses' id='i56g'><span class="gloss" id="i56g0">marten</span><span class="gloss" id="i56g1">one</span><span class="gloss" id="i56g2">otter</span><span class="gloss" id="i56g3">too</span><span class="gloss" id="i56g4">one</span><span class="gloss" id="i56g5">beaver</span><span class="gloss" id="i56g6">skin</span><span class="gloss" id="i56g7">too</span><span class="gloss" id="i56g8">one</span><span class="gloss" id="i56g9">I'll give you</span><span class="gloss" id="i56g10">its payment</span></span><br /><span class='trans' id='i56ft'>&quot;'I'll give you a marten skin, an otter skin, and a beaver skin too in payment.'</span></p></li>
<li><p class='igt' id='i57'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/58.mp3" class='audio'>hidden</a><span class='words' id='i57w'><span class="word" id="i57w0">Soxo</span><span class="word" id="i57w1">voqo</span><span class="word" id="i57w2">nitedoyh.&quot;</span></span><br /><span class='glosses' id='i57g'><span class="gloss" id="i57g0">for me</span><span class="gloss" id="i57g1">for it</span><span class="gloss" id="i57g2">you go back</span></span><br /><span class='trans' id='i57ft'>'Go back and get it for me.&quot;'</span></p></li>
<li><p class='igt' id='i58'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/59.mp3" class='audio'>hidden</a><span class='words' id='i58w'><span class="word" id="i58w0">&quot;Viyan',&quot;</span><span class="word" id="i58w1">yiɬne.</span></span><br /><span class='glosses' id='i58g'><span class="gloss" id="i58g0">no</span><span class="gloss" id="i58g1">he told him</span></span><br /><span class='trans' id='i58ft'>&quot;'No,&quot; he told him.'</span></p></li>
<li><p class='igt' id='i59'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/60.mp3" class='audio'>hidden</a><span class='words' id='i59w'><span class="word" id="i59w0">&quot;Nginh</span><span class="word" id="i59w1">gila'</span><span class="word" id="i59w2">iy,&quot;</span><span class="word" id="i59w3">yiɬne.</span></span><br /><span class='glosses' id='i59g'><span class="gloss" id="i59g0">you</span><span class="gloss" id="i59g1">go ahead</span><span class="gloss" id="i59g2">it</span><span class="gloss" id="i59g3">he told him</span></span><br /><span class='trans' id='i59ft'>&quot;'You do it,&quot; he told him.'</span></p></li>
<li><p class='igt' id='i60'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/61.mp3" class='audio'>hidden</a><span class='words' id='i60w'><span class="word" id="i60w0">&quot;Gila,</span><span class="word" id="i60w1">voqo</span><span class="word" id="i60w2">nitasdoɬ,&quot;</span><span class="word" id="i60w3">Yixgitsiy</span><span class="word" id="i60w4">yiɬne.</span></span><br /><span class='glosses' id='i60g'><span class="gloss" id="i60g0">okay</span><span class="gloss" id="i60g1">for it</span><span class="gloss" id="i60g2">I'll go back</span><span class="gloss" id="i60g3">Raven</span><span class="gloss" id="i60g4">he said to him</span></span><br /><span class='trans' id='i60ft'>&quot;'Okay, I'll go back for it,&quot; said Raven.'</span></p></li>
<li><p class='igt' id='i61'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/62.mp3" class='audio'>hidden</a><span class='words' id='i61w'><span class="word" id="i61w0">&quot;Yitongo</span><span class="word" id="i61w1">ghinguhoɬ</span><span class="word" id="i61w2">siqay</span><span class="word" id="i61w3">xits'in',&quot;</span><span class="word" id="i61w4">yiɬne.</span></span><br /><span class='glosses' id='i61g'><span class="gloss" id="i61g0">meanwhile</span><span class="gloss" id="i61g1">you go</span><span class="gloss" id="i61g2">my village</span><span class="gloss" id="i61g3">to</span><span class="gloss" id="i61g4">he told him</span></span><br /><span class='trans' id='i61ft'>&quot;'Meanwhile, you go on to my village.'</span></p></li>
<li><p class='igt' id='i62'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/63.mp3" class='audio'>hidden</a><span class='words' id='i62w'><span class="word" id="i62w0">&quot;Siqay</span><span class="word" id="i62w1">ningidiyo</span><span class="word" id="i62w2">da',&quot;</span><span class="word" id="i62w3">yiɬne,</span><span class="word" id="i62w4">getiy</span><span class="word" id="i62w5">ngichogh</span><span class="word" id="i62w6">nguhonh,&quot;</span><span class="word" id="i62w7">yiɬne.</span></span><br /><span class='glosses' id='i62g'><span class="gloss" id="i62g0">my village</span><span class="gloss" id="i62g1">you went</span><span class="gloss" id="i62g2">when</span><span class="gloss" id="i62g3">he said to him</span><span class="gloss" id="i62g4">really</span><span class="gloss" id="i62g5">big one</span><span class="gloss" id="i62g6">you eat</span><span class="gloss" id="i62g7">he said to him</span></span><br /><span class='trans' id='i62ft'>&quot;'When you get to my village, have a really big meal,&quot; he said.'</span></p></li>
<li><p class='igt' id='i63'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/64.mp3" class='audio'>hidden</a><span class='words' id='i63w'><span class="word" id="i63w0">Axaxiɬdik</span><span class="word" id="i63w1">Yixgitsiy</span><span class="word" id="i63w2">q'agh</span><span class="word" id="i63w3">ntithiyo.</span></span><br /><span class='glosses' id='i63g'><span class="gloss" id="i63g0">and then</span><span class="gloss" id="i63g1">Raven</span><span class="gloss" id="i63g2">back</span><span class="gloss" id="i63g3">he started to go</span></span><br /><span class='trans' id='i63ft'>'And then Raven started back.'</span></p></li>

<li><p class='igt' id='i22'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/23.mp3" class='audio'>hidden</a><span class='words' id='i22w'><span class="word" id="i22w0">Giɬixdi</span><span class="word" id="i22w1">xiyan'</span><span class="word" id="i22w2">yix</span><span class="word" id="i22w3">xidhu'onh</span><span class="word" id="i22w4">yitots'in'</span><span class="word" id="i22w5">tso</span><span class="word" id="i22w6">yiɬ</span><span class="word" id="i22w7">longh</span><span class="word" id="i22w8">yitongo.</span></span><br /><span class='glosses' id='i22g'><span class="gloss" id="i22g0">one</span><span class="gloss" id="i22g1">only</span><span class="gloss" id="i22g2">house</span><span class="gloss" id="i22g3">there is</span><span class="gloss" id="i22g4">and then</span><span class="gloss" id="i22g5">cache</span><span class="gloss" id="i22g6">also</span><span class="gloss" id="i22g7">many</span><span class="gloss" id="i22g8">at the same time</span></span><br /><span class='trans' id='i22ft'>'There was only one house there but there were a lot of caches.'</span></p></li>
<li><p class='igt' id='i23'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/24.mp3" class='audio'>hidden</a><span class='words' id='i23w'><span class="word" id="i23w0">Ghinoy</span><span class="word" id="i23w1">tth'in</span><span class="word" id="i23w2">yiɬ</span><span class="word" id="i23w3">longh</span><span class="word" id="i23w4">yix</span><span class="word" id="i23w5">xo'egh.</span></span><br /><span class='glosses' id='i23g'><span class="gloss" id="i23g0">caribou</span><span class="gloss" id="i23g1">bones</span><span class="gloss" id="i23g2">too</span><span class="gloss" id="i23g3">many</span><span class="gloss" id="i23g4">house</span><span class="gloss" id="i23g5">beside</span></span><br /><span class='trans' id='i23ft'>'There were a lot of caribou bones beside the house too.'</span></p></li>

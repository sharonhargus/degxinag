<li><p class='igt' id='i25'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/26.mp3" class='audio'>hidden</a><span class='words' id='i25w'><span class="word" id="i25w0">Giɬigginh</span><span class="word" id="i25w1">yan',</span><span class="word" id="i25w2">nq'oɬonh</span><span class="word" id="i25w3">yit</span><span class="word" id="i25w4">yiniɬggats</span><span class="word" id="i25w5">yuxudz.</span></span><br /><span class='glosses' id='i25g'><span class="gloss" id="i25g0">one person</span><span class="gloss" id="i25g1">only</span><span class="gloss" id="i25g2">woman</span><span class="gloss" id="i25g3">there</span><span class="gloss" id="i25g4">she stared at him</span><span class="gloss" id="i25g5">really</span></span><br /><span class='trans' id='i25ft'>'There was only one woman there and she really stared at him.'</span></p></li>
<li><p class='igt' id='i26'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/27.mp3" class='audio'>hidden</a><span class='words' id='i26w'><span class="word" id="i26w0">Xiyiɬ</span><span class="word" id="i26w1">di'ne</span><span class="word" id="i26w2">nq'oɬonh,</span><span class="word" id="i26w3">&quot;dina</span><span class="word" id="i26w4">ɬo</span><span class="word" id="i26w5">xelanh,&quot;</span><span class="word" id="i26w6">yiɬne.</span></span><br /><span class='glosses' id='i26g'><span class="gloss" id="i26g0">then</span><span class="gloss" id="i26g1">she said</span><span class="gloss" id="i26g2">woman</span><span class="gloss" id="i26g3">people</span><span class="gloss" id="i26g4">apparently</span><span class="gloss" id="i26g5">there are</span><span class="gloss" id="i26g6">she said to him</span></span><br /><span class='trans' id='i26ft'>'And she said &quot;why, there are other people.&quot;'</span></p></li>
<li><p class='igt' id='i27'><a href="//depts.washington.edu/dxmedia/Chapman/3__yixgitsiy_dina_diqay/mp3/28.mp3" class='audio'>hidden</a><span class='words' id='i27w'><span class="word" id="i27w0">Uxuxiyiɬ</span><span class="word" id="i27w1">Yixgitsiy</span><span class="word" id="i27w2">di'ne,</span><span class="word" id="i27w3">&quot;sidedig</span><span class="word" id="i27w4">dina</span><span class="word" id="i27w5">qul</span><span class="word" id="i27w6">xit'a</span><span class="word" id="i27w7">inisdhinh.&quot;'</span></span><br /><span class='glosses' id='i27g'><span class="gloss" id="i27g0">then</span><span class="gloss" id="i27g1">Raven</span><span class="gloss" id="i27g2">said</span><span class="gloss" id="i27g3">me too</span><span class="gloss" id="i27g4">people</span><span class="gloss" id="i27g5">not</span><span class="gloss" id="i27g6">maybe</span><span class="gloss" id="i27g7">I thought</span></span><br /><span class='trans' id='i27ft'>'And Raven said, &quot;I too thought perhaps there weren't any other people.&quot;'</span></p></li>

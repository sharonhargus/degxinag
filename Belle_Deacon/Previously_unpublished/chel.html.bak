<li><p class='igt' id='i173'><span class='words' id='i173w'><span class="word" id="i173w0">Ts'an</span><span class="word" id="i173w1">yuxudz</span><span class="word" id="i173w2">ngidiggi</span><span class="word" id="i173w3">tso</span><span class="word" id="i173w4">q'idz</span><span class="word" id="i173w5">dingonh</span><span class="word" id="i173w6">yiɬ</span><span class="word" id="i173w7">andidinelts'in'</span><span class="word" id="i173w8">.</span></span><br /><span class='glosses' id='i173g'><span class="gloss" id="i173g0">then</span><span class="gloss" id="i173g1">just</span><span class="gloss" id="i173g2">up</span><span class="gloss" id="i173g3">cache</span><span class="gloss" id="i173g4">on</span><span class="gloss" id="i173g5">his mother</span><span class="gloss" id="i173g6">too</span><span class="gloss" id="i173g7">he didn't tell</span></span><br /><span class='trans' id='i173ft'>'He went up in the cache without telling his mother.'</span></p></li>
<li><p class='igt' id='i174'><span class='words' id='i174w'><span class="word" id="i174w0">Ngiduggi</span><span class="word" id="i174w1">tso</span><span class="word" id="i174w2">ye</span><span class="word" id="i174w3">dadhiyo.</span></span><br /><span class='glosses' id='i174g'><span class="gloss" id="i174g0">up</span><span class="gloss" id="i174g1">cache</span><span class="gloss" id="i174g2">in</span><span class="gloss" id="i174g3">he went</span></span><br /><span class='trans' id='i174ft'>'He went in the cache.'</span></p></li>
